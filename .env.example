# Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ADMIN_USERNAME=mtu_admin
ADMIN_PASSWORD=your-secure-password-here

# Database (PostgreSQL URL from your provider)
# Examples:
#   Neon.tech: postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname
#   Supabase: postgresql://postgres:[PASSWORD]@db.xxx.supabase.co/postgres
#   Render: postgresql://user:pass@hostname/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/mtu_journal_evaluator

# App config
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
